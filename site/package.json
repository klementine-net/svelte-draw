{
	"name": "svelte-draw-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"license": "MIT",
	"description": "The documentation website of svelte-draw: static pages with live canvases, published to GitHub Pages beside the demo.",
	"engines": {
		"node": ">=24.13.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24.19.2",
		"marked": "^18.2.1",
		"mdsvex": "^0.12.8",
		"shiki": "^4.6.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.7"
	},
	"dependencies": {
		"@fontsource/caveat": "^5.3.0",
		"@fontsource/instrument-sans": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"svelte-draw": "workspace:*",
		"bits-ui": "^2.20.0",
		"phosphor-svelte": "^3.1.1",
		"svelte-draw-example-whiteboard": "workspace:*"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
