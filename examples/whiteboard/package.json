{
	"name": "svelte-draw-example-whiteboard",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"license": "MIT",
	"description": "A whiteboard on svelte-draw, kept in the browser and in step across tabs, with a set of controls to copy.",
	"engines": {
		"node": ">=24.13.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:browser": "vitest run"
	},
	"exports": {
		"./ui": "./src/lib/ui/index.ts",
		"./ui.css": "./src/lib/ui/ui.css",
		"./package.json": "./package.json"
	},
	"dependencies": {
		"@fontsource/caveat": "^5.3.0",
		"@fontsource/instrument-sans": "^5.3.0",
		"@simon-lund/svelte-draw": "workspace:*",
		"bits-ui": "^2.20.0",
		"phosphor-svelte": "^3.1.1"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.1.1",
		"playwright": "^1.64.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.1",
		"vitest-browser-svelte": "^3.1.0"
	}
}
