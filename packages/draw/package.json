{
	"name": "@klementine/svelte-draw",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"description": "An infinite canvas for Svelte: a plain TypeScript engine (record store, shape utils, tool state machines, undo) and a Svelte layer that draws it. Shapes and tools are plugins.",
	"keywords": [
		"svelte",
		"svelte5",
		"canvas",
		"infinite-canvas",
		"whiteboard",
		"drawing",
		"diagram",
		"shapes"
	],
	"author": "Simon Lund",
	"homepage": "https://docs.simon-lund.com/svelte-draw/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/simon-lund/svelte-draw.git",
		"directory": "packages/draw"
	},
	"bugs": "https://github.com/simon-lund/svelte-draw/issues",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "svelte-package --watch --preserve-output",
		"build": "svelte-package && publint",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "node --test 'tests/*.test.ts'",
		"test:browser": "vitest run",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"prepublishOnly": "pnpm run build"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css",
		"./dist/svelte/reactive.js"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core.d.ts",
			"svelte": "./dist/core.js",
			"default": "./dist/core.js"
		},
		"./draw.css": "./dist/draw.css",
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"svelte": "^5.57.1"
	},
	"dependencies": {
		"fractional-indexing": "^4.0.0",
		"perfect-freehand": "^1.2.2",
		"phosphor-svelte": "^3.1.1"
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.1.1",
		"playwright": "^1.64.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.7",
		"vitest": "^5.1.1",
		"vitest-browser-svelte": "^3.1.0"
	}
}
